# Braid — many strands, one line.
# Every tunable lives here. "braid plan" shows what a change would do;
# "/etc/init.d/braid reload" applies it. The dashboard edits the same file.
# Defaults and the full option list: /usr/share/braid/lib/config.uc

config braid 'main'
	option enabled '1'
	list lan_dev 'br-lan'
	list lan_dev 'lan1'
	list lan_dev 'lan2'
	list lan_dev 'lan3'
	list lan_dev 'lan4'
	list lan_dev 'phy0-ap0'
	list lan_dev 'phy1-ap0'
	option mss '1440'
	option ipv6 '0'

config strands 'strands'
	option aggregate 'auto'
	list uplink 'wan'
	list identity 'vwan*'
	list backup 'phy*-sta*'
	option probe_url 'http://connect.rom.miui.com/generate_204'
	option probe_expect '204'
	option probe_interval '180'

config site 'ihg'
	option name 'IHG 酒店'
	list gateway 'b4:4b:d6:57:18:0b'
	option aggregate '1'
	option portal 'linkbroad'
	option portal_secret 'portal.secret'

config weave 'weave'
	# harvest: token-bucket burst harvester (charges idle strands, bursts
	#          new flows on full buckets, cools down before policer tail-drop).
	# headroom: spare capacity. even: equal shares.
	option policy 'harvest'
	# flow: spread every new connection across @pattern (optimal when all
	#       strands share one public NAT IP). auto: spread after burst.
	option affinity 'flow'
	option spill '6'
	option slots '0'
	option interval '2'
	option strand_kbit '0'

config classify 'classify'
	option remainder 'tunnel'
	option quic 'reject'
	list tunnel_udp_port '123'
	list tunnel_udp_port '3478'
	list tunnel_udp_port '5349'
	list tunnel_udp_port '19302'

config tunnel 'tunnel'
	option enabled '1'
	option relays 'relays.json'
	option fail_open '0'
	list guard_ssh4 '18.176.216.3'

config dns 'dns'
	option ipv4_only '1'
	option ads '1'
	list cn_upstream 'https://223.5.5.5/dns-query dns.alidns.com'
	list cn_upstream 'https://223.6.6.6/dns-query dns.alidns.com'

config shaper 'shaper'
	option mode 'auto'
	option device 'wan'
	option pct '95'
	option pct_down '72'

config wifi 'wifi'
	option guard '1'
	list ap 'phy0-ap0'
	list ap 'phy1-ap0'
	option backup_sta 'sta'

config led 'led'
	option status 'rgb:status'
	option network 'rgb:network'
	option green '18'
	option yellow '8'

config device
	option mac 'f0:1f:c7:39:b8:30'
	option policy 'direct'

config device
	option mac '2a:89:78:1e:fa:40'
	option policy 'direct'

config device
	option mac '74:4c:a1:d6:bc:1d'
	option policy 'direct'

config device
	option mac 'ba:b8:2a:77:2e:47'
	option policy 'direct'

config device
	option mac '6e:bf:a3:ed:4e:b7'
	option policy 'direct'

config device
	option mac '9e:61:ba:f0:c9:a4'
	option policy 'direct'

config device
