#!/bin/sh /etc/rc.common
# Braid: one service, three instances. braidd weaves and schedules reconcile
# passes; procd restarts the two helper daemons when their rendered config
# changes.

START=99
STOP=10
USE_PROCD=1

RUN=/tmp/braid
BRAID=/usr/sbin/braid

start_service() {
	[ "$(uci -q get braid.main.enabled)" = 0 ] && return 0
	mkdir -p "$RUN"
	"$BRAID" prepare || logger -t braid "prepare failed"

	procd_open_instance braidd
	procd_set_param command /usr/bin/ucode -S /usr/share/braid/braidd.uc
	procd_set_param respawn 300 5 0
	procd_set_param stderr 1
	procd_close_instance

	if [ -s "$RUN/smartdns.conf" ]; then
		procd_open_instance smartdns
		procd_set_param command /usr/sbin/smartdns -f -c "$RUN/smartdns.conf" -p -
		procd_set_param file "$RUN/smartdns.conf"
		procd_set_param respawn 300 5 0
		procd_close_instance
	fi

	if [ -x "$RUN/mihomo" ] && [ -s "$RUN/mihomo.yaml" ]; then
		procd_open_instance mihomo
		procd_set_param env SAFE_PATHS=/etc/braid
		procd_set_param command "$RUN/mihomo" -d "$RUN" -f "$RUN/mihomo.yaml"
		procd_set_param respawn 300 5 0
		procd_set_param limits nofile="65535 65535"
		procd_set_param stderr 1
		procd_close_instance
	fi
}

stop_service() {
	"$BRAID" teardown
}

reload_service() {
	start
	"$BRAID" kick
}

service_triggers() {
	procd_add_reload_trigger braid
	procd_add_raw_trigger "interface.*" 3000 "$BRAID" kick
}
