{
	"_about": "UCI values `hotel provision` enforces. Sections that do not exist on a board are skipped.",
	"uci": {
		"firewall": {
			"@defaults[0]": {
				"flow_offloading": "0",
				"flow_offloading_hw": "0",
				"fullcone": "1",
				"fullcone6": "0",
				"drop_invalid": "0",
				"synflood_protect": "1"
			}
		},
		"network": {
			"globals": { "packet_steering": "2" },
			"lan": { "ipv6": "0" },
			"wan": { "ipv6": "0" },
			"wwan": { "ipv6": "0" },
			"wwan5": { "auto": "0", "ipv6": "0" },
			"wwan51": { "auto": "0", "ipv6": "0" },
			"wwan52": { "auto": "0", "ipv6": "0" },
			"wwan53": { "auto": "0", "ipv6": "0" },
			"wwan54": { "auto": "0", "ipv6": "0" }
		},
		"system": {
			"@system[0]": { "conloglevel": "5", "cronloglevel": "9", "watchdog": "1" }
		},
		"wireless": {
			"radio0": { "legacy_rates": "0" },
			"radio1": { "legacy_rates": "0", "channel": "36" },
			"default_radio0": {
				"disabled": "0", "wmm": "1", "disassoc_low_ack": "0", "skip_inactivity_poll": "1",
				"multicast_to_unicast": "0", "multicast_to_unicast_all": "0", "isolate": "0"
			},
			"default_radio1": {
				"wmm": "1", "disassoc_low_ack": "0", "skip_inactivity_poll": "1",
				"multicast_to_unicast": "0", "multicast_to_unicast_all": "0", "isolate": "0"
			},
			"sta5": { "disabled": "1" },
			"sta51": { "disabled": "1" },
			"sta52": { "disabled": "1" },
			"sta53": { "disabled": "1" },
			"sta54": { "disabled": "1" }
		}
	},
	"disable_services": [ "odhcpd", "radius" ],
	"irq_affinity": {
		"15100000.ethernet": [ "2", "4" ],
		"mt7915e": [ "8" ],
		"mtk_eth": [ "1" ]
	},
	"aql_txq_limit": {
		"0": [ 1500, 4000 ],
		"1": [ 1500, 4000 ],
		"2": [ 2500, 6000 ],
		"3": [ 2500, 6000 ]
	}
}
