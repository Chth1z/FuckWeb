#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
PROG=/tmp/hotel/mihomo
CONF=/etc/hotel/mihomo.yaml

start_service() {
	mkdir -p /tmp/hotel /var/run
	/usr/sbin/hotel-proxy.sh prepare || return 0
	[ -x "$PROG" ] || return 0
	[ -f "$CONF" ] || return 0
	procd_open_instance
	procd_set_param env SAFE_PATHS=/etc/hotel:/tmp/hotel:/www
	procd_set_param command "$PROG" -d /tmp/hotel -f "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param file "$CONF" /etc/hotel/proxy-nodes.json /etc/hotel/clash.secret /etc/hotel/claude-domains.list
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}

service_started() {
	/usr/sbin/hotel-proxy.sh attach >/dev/null 2>&1 || true
}

stop_service() {
	/usr/sbin/hotel-proxy.sh teardown >/dev/null 2>&1 || true
}
